        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/executive/v2/dvrs?month=10&year=2026",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "executive",
            "v2",
            "dvrs"
          ],
          "query": [
            {
              "key": "month",
              "value": "10"
